# Server
PORT=3000
NODE_ENV=production
LOG_FORMAT=combined
BODY_LIMIT=1mb
RATE_LIMIT_MAX=100

# Frontend URL(s) allowed by CORS (comma-separated)
CORS_ORIGIN=https://your-frontend.onrender.com

# Public frontend URL used to build absolute image links in order emails
PUBLIC_SITE_URL=https://joel87-hosy.github.io/site-JEMER

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=jemer_db

# SMTP (for nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password

# Admin email to receive notifications
ADMIN_EMAIL=jesusmerci.jemer@gmail.com

# Optional: disable real email sending (useful for staging)
SMTP_TEST=false
